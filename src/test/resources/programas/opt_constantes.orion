print(7 / 2, 1 / 3, 0.1 + 0.2, 2 ** 0.5);
print(-7 % 3, 2 ** 53, 9007199254740993 + 2);
print(1 / 10000000, 2 ** 1024, -0.0, (-2) ** 0.25);
print("hola\n" + "\"mundo\"\\", "\0" + "1", "a\t" + "b");
let global = 3;
fn cambiar() { global = 9; }
fn conservar(p: int) { let local = 4; cambiar(); print(local, p, global); }
cambiar();
print(global);
conservar(2);
