nav.toc ol.toc-list {
    list-style: none;
    font-size: var(--nav-font-size);
    padding-left: 0;
    margin: 0;
}
a.current-selection {
    font-weight: bold;
}
nav.toc a {
    display: block;
    padding: 8px;
    overflow: hidden;
    text-overflow: ellipsis;
