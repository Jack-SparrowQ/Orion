ul.preview-feature-list input {
    margin-right: 8px;
}
/*
 * Styles for tables.
 */
.summary-table, .details-table {
    border:1px solid var(--border-color);
    border-top:0;
    padding:0;
    margin-bottom: 14px;
}
.caption {
    overflow: auto hidden;
    padding: 8px 0 0 1px;
}
.caption span,
.inherited-list h3 {
