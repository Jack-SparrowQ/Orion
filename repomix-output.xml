    background-color: var(--toc-background-color);
    color: #666666;
    font-size: 0.76rem;
    cursor: pointer;
    padding: 6px 10px;
    white-space: nowrap;
    border: 1px solid transparent;
    border-radius: 3px;
}
.main-grid nav.toc button > img {
    vertical-align: middle;
    width: 16px;
    height: 16px;
}
.main-grid nav.toc button.hide-sidebar,
.main-grid nav.toc button.show-sidebar {
    position: absolute;
    bottom: 15px;
